rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Quy tắc cho User Profile (Bảo mật tài khoản)
    match /users/{userId} {
      // Cho phép đọc thông tin user đã đăng nhập (để lọc danh sách giáo viên/học sinh cùng trường)
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null &&
        (request.auth.uid == userId ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // 2. Quy tắc cho Hồ sơ Bác sĩ (doctors collection)
    match /doctors/{doctorId} {
      // Cho phép đọc thông tin bác sĩ đã đăng nhập (để hiển thị danh sách chuyên gia cho học sinh)
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == doctorId;
      allow update: if request.auth != null &&
        (request.auth.uid == doctorId ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // 3. Quy tắc cho Báo cáo Bạo lực học đường (reports)
    match /reports/{reportId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // 4. Quy tắc cho Thông báo gửi tới Giáo viên (notifications)
    match /notifications/{notificationId} {
      allow read, create, update: if request.auth != null;
    }

    // 5. Quy tắc cho Bộ mã xác thực Giáo viên (teacherCodes)
    match /teacherCodes/{codeId} {
      // Mở quyền Đọc (read) cho trang Đăng ký khi người dùng chưa login
      allow read: if true;
      allow create, update, write: if request.auth != null;
    }

    // 6. Quy tắc cho Phiên tư vấn Tâm lý Chatbot AI (chat_sessions)
    match /chat_sessions/{sessionId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // 7. Quy tắc cho Tin nhắn tư vấn Tâm lý Chatbot AI (chat_messages)
    match /chat_messages/{messageId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // 8. Quy tắc cho Hồ sơ Phân tích Tâm lý Học sinh (psychological_profiles)
    match /psychological_profiles/{profileId} {
      allow read, create, update: if request.auth != null;
    }

    // 9. Quy tắc cho Cộng đồng Hỏi đáp Q&A (qna_posts và comments)
    match /qna_posts/{postId} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null;
      
      match /comments/{commentId} {
        allow read, create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.senderUid;
      }
    }

    // 10. Quy tắc cho Chat 1-1 Học sinh ↔ Bác sĩ (doctorChats)
    match /doctorChats/{chatId} {
      // Chỉ học sinh hoặc bác sĩ trong cuộc trò chuyện mới được đọc/cập nhật
      allow read, update: if request.auth != null &&
        (request.auth.uid == resource.data.studentId ||
         request.auth.uid == resource.data.doctorId);
      // Cho phép tạo chat nếu đã đăng nhập (học sinh tạo chat mới với bác sĩ)
      allow create: if request.auth != null;

      match /messages/{messageId} {
        // Chỉ thành viên trong chat mới được đọc tin nhắn
        allow read: if request.auth != null &&
          (request.auth.uid == get(/databases/$(database)/documents/doctorChats/$(chatId)).data.studentId ||
           request.auth.uid == get(/databases/$(database)/documents/doctorChats/$(chatId)).data.doctorId);
        // Chỉ gửi tin nhắn nếu đã đăng nhập (là thành viên)
        allow create: if request.auth != null &&
          (request.auth.uid == get(/databases/$(database)/documents/doctorChats/$(chatId)).data.studentId ||
           request.auth.uid == get(/databases/$(database)/documents/doctorChats/$(chatId)).data.doctorId);
        allow update, delete: if false;
      }
    }

    // 11. Quy tắc cho Lịch hẹn tư vấn (appointments)
    match /appointments/{appointmentId} {
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      allow read, update: if request.auth != null && (
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.expertId
      );
      allow delete: if false;
    }

    // 12. Quy tắc cho Tin tức & Cẩm nang (newsArticles)
    match /newsArticles/{articleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        (request.resource.data.authorRole == 'teacher' || request.resource.data.authorRole == 'admin');
      allow update, delete: if request.auth != null && 
        (resource.data.authorId == request.auth.uid ||
         request.resource.data.authorRole == 'admin');
    }

    // 13. Quy tắc cho Thông báo gửi tới Học sinh (student_notifications)
    match /student_notifications/{notificationId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && resource.data.studentUid == request.auth.uid;
      allow delete: if false;
    }

  }
}
